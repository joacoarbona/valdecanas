B: (()=>{ const v=__vg; const pr=document.getElementById('mpPrompt'); const r={aviso:!pr.hidden, txt:document.getElementById('mpPromptTxt').textContent.slice(0,80)}; const b=pr.querySelector('button'); if(b) b.click(); return r; })()
{{
B: (()=>{ const v=__vg; v.setPaused(true); v.startDrop(); v.jumpFromPlane(); v.landNow(); v.P.vx=v.P.vy=v.P.vz=0; v.tick(80,1/30); const T=v.NV.tree; let O=null; for(let k=0;k<80&&!O;k++){ const a=k*0.9, d=12+k*0.6, x=T.x+Math.cos(a)*d, z=T.z+Math.sin(a)*d; let ok=true; for(let q=0;q<16&&ok;q++){ const b=q/16*Math.PI*2; if(v.bldAt(x+Math.cos(b)*7,z+Math.sin(b)*7,0.5)||v.W.surfAt(x,z)===5) ok=false; } if(ok&&!v.bldAt(x,z,2)) O=[x,z]; } v.P.x=O[0]; v.P.z=O[1]+3.5; v.P.y=v.groundAt(v.P.x,v.P.z,99); v.S.snap=true; v.tick(5,1/30); return {on:v.NV.on, nieve:v.SNOWU.value}; })()
}}
{{
A: (()=>{ const v=__vg; v.snGo(v.SN.racks[0],{now:true}); v.inp.my=0; v.tick(40,1/30); return {modo:v.S.mode}; })()
}}
