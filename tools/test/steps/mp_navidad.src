{{
A: (()=>{ const v=__vg; const p=[...v.MP.peers.values()][0]; let hit=0; v.tick(30,1/30); for(let k=0;k<12&&!hit;k++){ const s=p.out; const dx=s.x-v.P.x, dz=s.z-v.P.z, d=Math.hypot(dx,dz); v.P.yaw=Math.atan2(dz,dx); v.camS.yaw=v.P.yaw; v.camS.pitch=0.12-k*0.04; v.tick(5,1/30); const h0=v.SN.st.h; v.snThrow(); for(let j=0;j<45;j++){ v.tick(1,1/30); if(v.SN.st.h>h0){ hit=1; break; } } v.tick(14,1/30); } return {acierto:hit, lanzadas:v.SN.st.t}; })()
}}
