{{
B: (()=>{ const v=__vg; const p=[...v.MP.peers.values()][0], s=p.out; const R=v.SN.racks[0]; v.P.x=R.start[0]-R.f[0]*8; v.P.z=R.start[1]-R.f[1]*8+3; v.P.y=v.groundAt(v.P.x,v.P.z,99); v.P.yaw=Math.atan2(R.start[1]-v.P.z,R.start[0]-v.P.x); v.camS.yaw=v.P.yaw; v.S.snap=true; v.tick(3,1/30); return {modoDeAna:s&&s.m, trineo:!!(p.snM&&p.snM.visible), nv:s&&s.nv}; })()
}}
