{{
A: (()=>{ const v=__vg, S=v.SN, L=S.sl, p=L.c.pts; let n=0; while(S.sl&&n<3600){ const j=Math.min(p.length-1,L.k+5), a=Math.atan2(p[j][1]-L.z,p[j][0]-L.x); let d=a-L.yaw; while(d>Math.PI) d-=2*Math.PI; while(d<-Math.PI) d+=2*Math.PI; v.inp.mx=Math.max(-1,Math.min(1,d*2.5)); v.inp.my=L.v<2?1:0; v.tick(1,1/30); n++; if(S.race.fin) break; } v.inp.mx=v.inp.my=0; return {fin:S.race.fin, modo:v.S.mode}; })()
}}
