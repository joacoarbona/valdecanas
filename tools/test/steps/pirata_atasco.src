# Pirata: el cañón ya no deja atascado. Disparos aleatorios junto a las casas (nunca dentro de una pared ni en vuelo sin fin), disparo a bocajarro contra una pared (rebota y cae), disparo que cae en el patio de una villa (te saca solo) y patio a pie
js: __vg.setPaused(true)
{{
(()=>{ const v=__vg; v.setTOD('mediodia'); v.startDrop(); v.jumpFromPlane(); v.landNow(); v.P.vx=v.P.vz=0; v.tick(30,1/30); v.PRG.coins=9999; v.prgBuy('h-pirata'); v.tick(2,1/30);
 const q={k:'walk',o:v.P}; window.pa={ v, q, B:v.BLD.filter(b=>b.ring&&b.solid),
  at(x,z,yaw){ if(v.S.mode==='pow') v.pwClear(); if(v.S.mode!=='walk') v.setMode('walk'); v.P.x=x; v.P.z=z; v.P.y=v.groundAt(x,z,v.W.terrain(x,z)+2); v.P.vx=v.P.vy=v.P.vz=0; v.P.swim=false; v.P.onGround=true; v.PW.cd=0; v.camS.yaw=yaw; v.camS.lastLook=0; v.tick(3,1/30); },
  inWall(){ const P=v.P; for(const b of this.B){ if(P.x<b.x0||P.x>b.x1||P.z<b.z0||P.z>b.z1) continue; if(P.y<(b.walkY!==undefined?b.walkY:b.top)-0.1&&P.y+1.5>b.base&&v.bldAt(P.x,P.z,0)===b) return b; } return null; },
  fly(max){ let n=0; while(n<(max||900)){ v.tick(1,1/30); n++; if(v.S.mode==='walk'||v.P.swim) break; } return n; } };
 return v.pwCos(); })()
}}
# 1 · 120 disparos al azar desde 0,6-4,6 m de una pared, hacia la casa o hacia los lados
{{
(()=>{ const {v,q,B}=pa; let seed=11; const R=()=>{ seed=(seed*1664525+1013904223)>>>0; return seed/4294967296; }; let tried=0, maxN=0; const bad=[];
 for(let tr=0;tr<150&&tried<120;tr++){ const b=B[(R()*B.length)|0], r=b.ring, i=(R()*r.length)|0, a=r[i], c=r[(i+1)%r.length]; const mx=(a[0]+c[0])/2, mz=(a[1]+c[1])/2, L=Math.hypot(c[0]-a[0],c[1]-a[1])||1; let nx=(c[1]-a[1])/L, nz=-(c[0]-a[0])/L; if(v.bldAt(mx+nx*0.5,mz+nz*0.5,0)){ nx=-nx; nz=-nz; } const d=0.6+R()*4, x=mx+nx*d, z=mz+nz*d; if(v.bldAt(x,z,0.4)||!v.dsSpot(q,x,z)) continue;
  const toward=Math.atan2(-nz,-nx); pa.at(x,z,toward+(R()-0.5)*2); if(!v.P.onGround||v.S.mode!=='walk') continue; tried++;
  v.pwPress(); v.tick(10,1/30); const C=v.PW.cn; if(!C){ bad.push([tr,'sin cañón']); continue; } C.yaw=toward+(R()-0.5)*2.4; C.el=0.3+R()*0.85; v.tick(10,1/30); v.pwFire(); const n=pa.fly(); maxN=Math.max(maxN,n);
  if(n>=900||pa.inWall()||!isFinite(v.P.x)) bad.push([tr,n,v.S.mode,v.PW.k]); }
 return {disparos:tried, fotogramasMax:maxN, malos:bad}; })()
}}
# 2 · a bocajarro contra una pared, casi en horizontal: rebota hacia fuera, cae y no queda dentro
{{
(()=>{ const {v,q,B}=pa; for(const b of B){ if(b.top-b.base<5.5) continue; const r=b.ring; for(let i=0;i<r.length;i++){ const a=r[i], c=r[(i+1)%r.length], L=Math.hypot(c[0]-a[0],c[1]-a[1]); if(L<8) continue; const mx=(a[0]+c[0])/2, mz=(a[1]+c[1])/2; let nx=(c[1]-a[1])/L, nz=-(c[0]-a[0])/L; if(v.bldAt(mx+nx*0.5,mz+nz*0.5,0)){ nx=-nx; nz=-nz; } const x=mx+nx*3.2, z=mz+nz*3.2; if(v.bldAt(x,z,1.2)||!v.dsSpot(q,x,z)||!v.dsSpot(q,mx+nx*12,mz+nz*12)||v.bldAt(mx+nx*12,mz+nz*12,2)) continue;
   const toward=Math.atan2(-nz,-nx); pa.at(x,z,toward+1.57); v.pwPress(); v.tick(10,1/30); const C=v.PW.cn; C.yaw=toward; C.el=0.32; v.tick(10,1/30); const y0=v.P.y; v.pwFire(); v.tick(4,1/30); const vOut=+(v.P.vx*nx+v.P.vz*nz).toFixed(1); const n=pa.fly(); const dOut=+((v.P.x-mx)*nx+(v.P.z-mz)*nz).toFixed(1);
   return {pared:[Math.round(mx),Math.round(mz)],altoPared:+(b.top-b.base).toFixed(1),velHaciaFuera:vOut,segundos:+(n/30).toFixed(1),modo:v.S.mode,dentro:!!pa.inWall(),distPared:dOut,enTejado:v.P.y>b.walkY-0.2}; } } return 'sin pared'; })()
}}
# 3 · tras el cañón se abre el planeador; si bajas planeando dentro del patio de una villa, al poco te saca fuera
{{
(()=>{ const {v,q,B}=pa; const W=v.W; for(const b of B){ if(!b.holesO||!b.holesO.length||b.top-b.base<5) continue; const h=b.holesO[0]; let cx=0,cz=0; for(const p of h){ cx+=p[0]; cz+=p[1]; } cx/=h.length; cz/=h.length; if(!W.pointInPoly(cx,cz,h)) continue;
  pa.at(cx+40,cz,3.14); v.P.x=cx; v.P.z=cz; v.P.y=b.top-0.4; v.P.vx=v.P.vz=0; v.P.vy=-3; v.P.onGround=false; v.P.yaw=0; v.setMode('glide'); let n=0; while(n<300&&v.S.mode!=='walk'){ v.tick(1,1/30); n++; }
  const pos=[+v.P.x.toFixed(1),+v.P.y.toFixed(1),+v.P.z.toFixed(1)], inP=!!v.dsPatio(v.P.x,v.P.z,v.P.y); v.tick(10,1/30); const still=!!v.dsPatio(v.P.x,v.P.z,v.P.y); v.tick(40,1/30);
  return {aterriza:pos, suelo:+v.W.terrain(cx,cz).toFixed(1), enElPatio:inP, seguíaAl03s:still, fueraDespues:!v.dsPatio(v.P.x,v.P.z,v.P.y), distanciaAlPatio:Math.round(Math.hypot(v.P.x-cx,v.P.z-cz)), aviso:v.DS.last&&v.DS.last.k, modo:v.S.mode, enPared:!!pa.inWall(), puedeAndar:(()=>{ const x0=v.P.x,z0=v.P.z; v.inp.my=1; v.tick(30,1/30); v.inp.my=0; return +Math.hypot(v.P.x-x0,v.P.z-z0).toFixed(1); })()}; } return 'sin patio'; })()
}}
shot: pirata_patio_fuera
# 4 · a pie dentro de un patio (por ejemplo, tras el fantasma): fuera; y Desatascar nunca te deja en un patio
{{
(()=>{ const {v,q,B}=pa; const W=v.W; for(const b of B){ if(!b.holesO||!b.holesO.length) continue; const h=b.holesO[0]; let cx=0,cz=0; for(const p of h){ cx+=p[0]; cz+=p[1]; } cx/=h.length; cz/=h.length; if(!W.pointInPoly(cx,cz,h)) continue;
  pa.at(cx,cz,0); const dentro=!!v.dsPatio(v.P.x,v.P.z,v.P.y); v.tick(20,1/30); const aun=!!v.dsPatio(v.P.x,v.P.z,v.P.y); v.tick(30,1/30); const fuera=!v.dsPatio(v.P.x,v.P.z,v.P.y);
  const spot=v.dsSpot(q,cx,cz); pa.at(cx,cz,0); v.DS.pt=-99; const ok=v.dsUnstick(false); v.DS.pt=0; return {dentro, aunA07s:aun, fueraA17s:fuera, desatascarFuera:ok&&!v.dsPatio(v.P.x,v.P.z,v.P.y), patioNoEsSitioLibre:!spot, enPared:!!pa.inWall()}; } return 'sin patio'; })()
}}
