# E1b (cuentas dentro de lo que más le gusta, solo Valdecañas): aros de cuentas volando (helicóptero y escoba), boyas de cuentas en la moto de agua,
# truco o trato con cuenta, cofres con candado de números, descuento en la tienda (Premios, Halloween y garaje), interruptor de padres, mapa, guía y glosario.
# Se une con: python3 tools/test/mkst.py tools/test/steps/cuentas_e1b.src tools/test/steps/cuentas_e1b.txt
js: __vg.setPaused(true)
{{
(()=>{ const v=__vg; localStorage.removeItem('vg_mt'); v.mtLoad(); v.setTOD('mediodia'); v.startDrop(); v.jumpFromPlane(); v.landNow(); v.P.vx=v.P.vz=0; v.tick(30,1/30);
  window.e1={ wait:ms=>new Promise(r=>setTimeout(r,ms)),
    ans(ok){ const q=v.MT.q.cur; String(ok?q.ans:q.ans+1).split('').forEach(d=>v.mtKey(d)); v.mtKey('ok'); },
    // crosses a gate from 6 m before its plane to 6 m after, through slot j (0-2), or j=null (the centre: the start), or j=5 (outside)
    pass(Z,j){ const C=v.ME_C[v.ME.k], air=v.ME.k==='aire', off=j==null?0:(j-1)*C.gap, y=air?Z.y-1.2:0;
      const put=d=>{ const x=Z.x+Z.tx*d+Z.nx*off, z=Z.z+Z.tz*d+Z.nz*off; if(air){ const A=v.S.mode==='pow'?v.PW.br:v.P.fly; A.x=x; A.y=y; A.z=z; A.vf=0; A.vy=0; A.gnd=false; if(A.v!==undefined) A.v=0; } else { const J=v.P.jet; J.x=x; J.z=z; J.v=0; v.P.x=x; v.P.z=z; } };
      put(-6); v.tick(2,1/30); put(6); v.tick(1,1/30); },
    hud(){ return [...['meT1','meQ','meT2']].map(i=>document.getElementById(i).textContent).join(' | '); } };
  const p=v.mtNew('Leo','🚁'); p.t=true; p.lv=3; p.d=0.5; v.mtSave(); v.MT.play=0;
  return {perfil:p.nm, nivel:p.lv, enJuego:v.MT.d.ing, hud:document.getElementById('meHud').hidden?'oculto':'visible', trofeos:v.TRO.filter(t=>t.w==='cuentas').map(t=>t.id)}; })()
}}
# ---- los números que no son: dos distintos, ninguno el resultado ni negativo ----
{{
(()=>{ const v=__vg; let bad=0; const ej=[]; for(let lv=1;lv<=6;lv++) for(let i=0;i<500;i++){ const q=v.mtGen(lv,i/500), w=v.meWrong(q); if(w.length!==2||w[0]===w[1]||w.includes(q.ans)||w.some(x=>x<0||!Number.isInteger(x))) bad++; if(i===250) ej.push(q.key+'='+q.ans+' → '+w.join(', ')); } return {fallos:bad, ejemplos:ej}; })()
}}
# ---- hoja Cuentas: la sección «Cuentas en el juego» ----
{{
(()=>{ const v=__vg; v.mtSheet('jugar'); const B=document.getElementById('mtBody'); return {aros:!!B.querySelector('[data-mego="aire"]'), boyas:!!B.querySelector('[data-mego="agua"]'), texto:[...B.querySelectorAll('h3')].map(h=>h.textContent)}; })()
}}
shot: e1b_hoja
# ---- aros de cuentas: desde la hoja te lleva al helipuerto del hotel; pilotas y aparecen la salida y las 8 puertas ----
{{
(async()=>{ const v=__vg; document.querySelector('[data-mego="aire"]').click(); await e1.wait(900); v.tick(6,1/30);
  const M=v.ME, pad=v.FL.pads.find(p=>p.n==='Hotel'); const A=pad.a; v.flEnter(A); v.tick(4,1/30);
  const Z=M.sta[1]; return {activo:M.on, fase:M.st, puertas:M.sta.length-1, salidaDelHelipuerto:Math.round(Math.hypot(M.sta[0].x-pad.x,M.sta[0].z-pad.z)), hoja:document.getElementById('mtSheet').hidden?'cerrada':'abierta', modo:v.S.mode,
    aros:Z.m.length, numeros:Z.vals, bueno:Z.ci, cuenta:Z.q.key+'='+Z.q.ans, alturaSobreSuelo:Math.round(Z.y-v.W.terrain(Z.x,Z.z)), arosDelCielo:v.FL.rg.visible, hud:e1.hud(), recorrido:Math.round(M.len)+' m', medallas:M.med}; })()
}}
# ---- vista desde la aeronave hacia la primera puerta ----
{{
(()=>{ const v=__vg, M=v.ME, Z=M.sta[0], A=v.P.fly; A.x=Z.x-Z.tx*55; A.z=Z.z-Z.tz*55; A.y=Z.y+2; A.vf=0; A.vy=0; A.gnd=false; A.yaw=Math.atan2(Z.tz,Z.tx); v.camS.yaw=A.yaw; v.camS.pitch=0.08; v.S.snap=true; v.tick(8,1/30); return e1.hud(); })()
}}
shot: e1b_aros_salida
{{
(()=>{ const v=__vg, M=v.ME, Z=M.sta[1], A=v.P.fly; A.x=Z.x-Z.tx*70; A.z=Z.z-Z.tz*70; A.y=Z.y+3; A.vf=0; A.vy=0; A.gnd=false; A.yaw=Math.atan2(Z.tz,Z.tx); v.camS.yaw=A.yaw; v.camS.pitch=0.06; v.S.snap=true; v.tick(8,1/30); return e1.hud(); })()
}}
shot: e1b_aros_puerta
# ---- salida, puerta sin pasar por dentro (no cuenta), acierto, fallo (+4 s) y el resto bien ----
{{
(()=>{ const v=__vg, M=v.ME, p=v.mtP(), tot0=p.tot, out={}; e1.pass(M.sta[0],null); out.salida={fase:M.st, siguiente:M.next, hud:e1.hud()};
  e1.pass(M.sta[1],3); out.porFuera={siguiente:M.next, fuera:M.miss, aviso:document.getElementById('tip').textContent};
  const Z1=M.sta[1]; e1.pass(Z1,Z1.ci); out.acierto={bien:M.ok, siguiente:M.next, aviso:document.getElementById('tip').textContent};
  const Z2=M.sta[2], t0=M.t; e1.pass(Z2,(Z2.ci+1)%3); out.fallo={mal:M.bad, segundosDeMas:+(M.t-t0).toFixed(1), aviso:document.getElementById('tip').textContent, aroBuenoQuedaVerde:Z2.m[Z2.ci].material===M.mats.ok};
  out.hud=e1.hud(); out.cuentasApuntadas=p.tot-tot0; out.nivelNoCambia=p.lv; return out; })()
}}
shot: e1b_aros_hud
{{
(()=>{ const v=__vg, M=v.ME, p=v.mtP(), c0=v.PRG.coins; for(let i=3;i<=8;i++){ const Z=M.sta[i]; e1.pass(Z,Z.ci); } const R=M.res;
  return {activo:M.on, bien:R.ok+' de '+R.n, tiempo:(R.ms/1000).toFixed(1)+' s', medalla:R.md||'ninguna', record:R.isRec, guardado:!!v.meRec('aire'), monedasCuentas:R.cc, monedas:v.PRG.coins-c0, tarjeta:!document.getElementById('mtCard').hidden, filas:document.querySelectorAll('#mtCardB tbody tr').length,
    titulo:document.querySelector('#mtCardB h2').textContent, arosDelCielo:v.FL.rg.visible, hud:document.getElementById('meHud').hidden?'oculto':'visible', trofeoSinFallos:!!v.PRG.tro.mtaros}; })()
}}
shot: e1b_aros_final
# ---- repetir con otras cuentas; esta vez todo bien → oro y trofeo «Piloto de cuentas» ----
{{
(()=>{ const v=__vg, M=v.ME; const q0=M.res.rows.map(r=>r.q.key); document.getElementById('meAgain').click(); v.tick(2,1/30); const q1=M.sta.slice(1).map(Z=>Z.q.key);
  e1.pass(M.sta[0],null); for(let i=1;i<=8;i++){ const Z=M.sta[i]; e1.pass(Z,Z.ci); } const R=M.res;
  return {otrasCuentas:q1.filter(k=>!q0.includes(k)).length+' de 8 distintas', sinRepetir:new Set(q1).size, bien:R.ok, medalla:R.md, trofeo:!!v.PRG.tro.mtaros, record:R.isRec, mejor:(v.meRec('aire').ms/1000).toFixed(1)+' s'}; })()
}}
js: (()=>{ document.getElementById('mtEndB').click(); return document.getElementById('mtCard').hidden; })()
# ---- dejarlo: con el botón del marcador y bajándose de la aeronave a mitad ----
{{
(()=>{ const v=__vg, M=v.ME; v.meStart('aire'); v.tick(2,1/30); const on=M.on, fase=M.st; document.getElementById('meX').click(); v.tick(3,1/30); const a={conBoton:{antes:on+' '+fase, despues:M.on, hud:document.getElementById('meHud').hidden?'oculto':'visible', arosDelCielo:v.FL.rg.visible}};
  v.meStart('aire'); v.tick(2,1/30); e1.pass(M.sta[0],null); const f=M.st; const A=v.P.fly; A.y=v.groundAt(A.x,A.z,999); A.gnd=true; v.flExit ? v.flExit() : v.setMode('walk'); v.tick(90,1/30);
  a.alBajarse={fase:f, modo:v.S.mode, activo:M.on, aviso:document.getElementById('toastB').textContent}; return a; })()
}}
# ---- con la escoba de la bruja también vale ----
{{
(()=>{ const v=__vg, M=v.ME; v.prgBuy('h-bruja'); v.tick(2,1/30); const p0=v.P; let x=-723, z=101; v.P.x=x; v.P.z=z; v.P.y=v.groundAt(x,z,999); v.P.vx=v.P.vz=0; v.P.onGround=true; v.setMode('walk'); v.tick(3,1/30);
  v.pwPress(); v.tick(4,1/30); const ok0=v.meFlyNow(); v.meStart('aire'); v.tick(2,1/30); e1.pass(M.sta[0],null); const Z=M.sta[1]; e1.pass(Z,Z.ci);
  const r={modo:v.S.mode, poder:v.PW.k, valeLaEscoba:ok0, fase:M.st, bien:M.ok, siguiente:M.next, salioSolo:!document.getElementById('mtCard').hidden?'tarjeta':'no'}; v.meEnd('quit'); v.pwClear(); v.setMode('walk'); v.prgBase('disfraz'); v.tick(2,1/30); return r; })()
}}
# ---- boyas de cuentas en la moto de agua ----
{{
(async()=>{ const v=__vg, M=v.ME; v.mtSheet('jugar'); document.querySelector('[data-mego="agua"]').click(); await e1.wait(900); v.tick(4,1/30);
  const Z=M.sta[1], s0=M.sta[0]; return {activo:M.on, k:M.k, modo:v.S.mode, moto:v.P.jet&&(v.P.jet.type||'jet'), aSalida:Math.round(Math.hypot(v.P.x-s0.x,v.P.z-s0.z)), boyas:Z.m.length, numeros:Z.vals, agua:+(v.W.waterLevel(Z.x,Z.z)-v.W.terrain(Z.x,Z.z)).toFixed(1), hud:e1.hud(), medallas:M.med}; })()
}}
{{
(()=>{ const v=__vg, M=v.ME, Z=M.sta[1], J=v.P.jet; J.x=Z.x-Z.tx*28; J.z=Z.z-Z.tz*28; J.v=0; J.yaw=Math.atan2(Z.tz,Z.tx); v.P.x=J.x; v.P.z=J.z; v.camS.yaw=J.yaw; v.camS.pitch=0.12; v.S.snap=true; v.tick(8,1/30); return e1.hud(); })()
}}
shot: e1b_boyas
{{
(()=>{ const v=__vg, M=v.ME, c0=v.PRG.coins; e1.pass(M.sta[0],null); const f=M.st; e1.pass(M.sta[1],3); const fuera=M.miss; for(let i=1;i<=8;i++){ const Z=M.sta[i]; e1.pass(Z,i===4?(Z.ci+2)%3:Z.ci); } const R=M.res;
  return {fase:f, porFuera:fuera, bien:R.ok+' de '+R.n, tiempo:(R.ms/1000).toFixed(1)+' s', medalla:R.md||'ninguna', trofeo:!!v.PRG.tro.mtboyas, guardado:!!v.meRec('agua'), filas:document.querySelectorAll('#mtCardB tbody tr').length, mal:R.rows.filter(r=>!r.ok).map(r=>r.q.key+' → '+r.v)}; })()
}}
js: (()=>{ document.getElementById('mtEndB').click(); __vg.dismountJet(); __vg.tick(3,1/30); return {tarjeta:document.getElementById('mtCard').hidden, modo:__vg.S.mode}; })()
# ---- truco o trato con cuenta: acierto (3 caramelos más), dos fallos (trato normal) y «Solo el trato» ----
{{
(async()=>{ const v=__vg, H=v.HL; v.hlSet(true); v.tick(10,1/30); const at=(h,d)=>{ const P=v.P; P.x=h.x+h.nx*d; P.z=h.z+h.nz*d; P.y=v.groundAt(P.x,P.z,h.y+1); P.vx=P.vy=P.vz=0; P.yaw=Math.atan2(h.mz-P.z,h.mx-P.x); v.camS.yaw=P.yaw; v.setMode('walk'); v.S.snap=true; v.tick(4,1/30); };
  const out=[]; let i=0; for(const how of ['bien','mal','solo']){ const h=H.houses.filter(x=>!H.night.v.includes(x.id))[0]; at(h,0.6); v.hlKnock(h); v.tick(62,1/30); const c0=H.night.c; v.hlChoose('trato'); const Q=v.MT.q;
    const r={casa:h.n, estado:H.visit.st, modo:Q&&Q.mode, texto:(document.querySelector('#mtCardB .mtfr')||{}).textContent, salir:document.getElementById('mtQuit').textContent};
    if(how==='bien'){ e1.ans(true); await e1.wait(1100); }
    else if(how==='mal'){ e1.ans(false); e1.ans(false); r.boton=document.getElementById('mtNextB').textContent; document.getElementById('mtNextB').click(); }
    else document.getElementById('mtQuit').click();
    v.tick(3,1/30); r.despues=H.visit&&H.visit.st; r.caramelos=H.night.c-c0; r.bocadillo=H.visit&&H.visit.say; r.tarjeta=document.getElementById('mtCard').hidden?'cerrada':'abierta'; out.push(r); v.tick(150,1/30); }
  return out; })()
}}
{{
(()=>{ const v=__vg, H=v.HL; v.MT.d.ing=false; const h=H.houses.filter(x=>!H.night.v.includes(x.id))[0]; const P=v.P; P.x=h.x+h.nx*0.6; P.z=h.z+h.nz*0.6; P.y=v.groundAt(P.x,P.z,h.y+1); v.setMode('walk'); v.tick(4,1/30); v.hlKnock(h); v.tick(62,1/30); const c0=H.night.c; v.hlChoose('trato'); v.tick(2,1/30);
  const r={sinCuentas:{estado:H.visit.st, tarjeta:document.getElementById('mtCard').hidden?'cerrada':'abierta', caramelos:H.night.c-c0}}; v.MT.d.ing=true; v.tick(150,1/30); v.hlSet(false); v.tick(5,1/30); return r; })()
}}
# ---- cofres del tesoro con candado de números ----
{{
(()=>{ const v=__vg, T=v.TS; v.meLocks(); const C=T.list.find(c=>!c.open); const L=C.m.userData.mel; const ry=C.m.rotation.y, fx=Math.sin(ry), fz=Math.cos(ry); v.P.x=C.x+fx*2-fz*0.5; v.P.z=C.z+fz*2+fx*0.5; v.P.y=v.groundAt(v.P.x,v.P.z,C.y+1); v.P.vx=v.P.vz=0; v.setMode('walk'); v.P.yaw=Math.atan2(C.z-v.P.z,C.x-v.P.x); v.camS.yaw=v.P.yaw+0.45; v.camS.pitch=0.42; v.setTOD('manana'); v.S.snap=true; v.tick(6,1/30);
  return {cofres:T.list.length, candados:T.list.filter(c=>c.m.userData.mel&&c.m.userData.mel.visible).length, accion:document.getElementById('bAct').textContent, candadoVisible:!!L&&L.visible}; })()
}}
shot: e1b_candado
{{
(async()=>{ const v=__vg, T=v.TS, out=[]; for(const how of ['bien','mal','luego']){ const C=T.list.find(c=>!c.open); v.P.x=C.x+1.2; v.P.z=C.z; v.P.y=v.groundAt(v.P.x,v.P.z,C.y+1); v.setMode('walk'); v.tick(4,1/30); const m0=v.PRG.coins;
    v.doAction(); v.tick(1,1/30); const Q=v.MT.q; const r={cofre:C.pl.n, modo:Q&&Q.mode, abiertoAntes:C.open, texto:(document.querySelector('#mtCardB .mtfr')||{}).textContent.slice(0,60)};
    if(how==='bien'){ e1.ans(true); await e1.wait(1100); } else if(how==='mal'){ e1.ans(false); e1.ans(false); r.boton=document.getElementById('mtNextB').textContent; document.getElementById('mtNextB').click(); await e1.wait(500); } else { r.salir=document.getElementById('mtQuit').textContent; document.getElementById('mtQuit').click(); }
    v.tick(2,1/30); v.meLocks(); r.abierto=C.open; r.monedas=v.PRG.coins-m0; r.candado=C.m.userData.mel?C.m.userData.mel.visible:'sin'; out.push(r); document.getElementById('tsCard').hidden=true; v.TS.q=[]; }
  return out; })()
}}
# ---- tienda: «Tienes 45, cuesta 30» con descuento; dos fallos = precio normal; sin descuento; cancelar; menos de 10 monedas sin cuenta ----
{{
(async()=>{ const v=__vg, p=v.mtP(); p.lv=6; const it=v.SHOP.find(s=>s.p>=20&&s.p<=40&&!s.req&&!v.prgOwned(s)); v.PRG.coins=45; v.openModal('premios',{title:'Premios'}); await e1.wait(100);
  document.querySelector('[data-buy="'+it.id+'"]').click(); const Q=v.MT.q, r={objeto:it.n, precio:it.p, modo:Q&&Q.mode, cuenta:Q&&Q.cur.key, texto:(document.querySelector('#mtCardB .mtfr')||{}).textContent, tarjetaEncima:getComputedStyle(document.getElementById('mtCard')).zIndex+' > '+getComputedStyle(document.getElementById('modal')).zIndex, alt:(document.getElementById('mtAlt')||{}).textContent, salir:document.getElementById('mtQuit').textContent};
  e1.ans(true); await e1.wait(1500); r.comprado=!!v.PRG.own[it.id]; r.quedan=v.PRG.coins; r.esperado=45-(it.p-Math.max(1,Math.round(it.p*0.1))); r.apunte=v.PRG.log[0][2]; r.aviso=document.getElementById('tip').textContent; return r; })()
}}
shot: e1b_tienda_hecha
{{
(async()=>{ const v=__vg, out={}; const pick=()=>v.SHOP.find(s=>s.p>=10&&s.p<=60&&!s.req&&!v.prgOwned(s)&&document.querySelector('[data-buy="'+s.id+'"]'));
  v.PRG.coins=200; v.openModal('premios',{title:'Premios'}); await e1.wait(100); let it=pick(); document.querySelector('[data-buy="'+it.id+'"]').click(); out.ficticia=(document.querySelector('#mtCardB .mtfr')||{}).textContent;
  e1.ans(false); e1.ans(false); out.boton=document.getElementById('mtNextB').textContent; document.getElementById('mtNextB').click(); await e1.wait(100); out.dosFallos={comprado:!!v.PRG.own[it.id], pagado:200-v.PRG.coins, precio:it.p};
  let c0=v.PRG.coins; it=pick(); document.querySelector('[data-buy="'+it.id+'"]').click(); document.getElementById('mtAlt').click(); await e1.wait(100); out.sinDescuento={comprado:!!v.PRG.own[it.id], pagado:c0-v.PRG.coins, precio:it.p};
  c0=v.PRG.coins; it=pick(); document.querySelector('[data-buy="'+it.id+'"]').click(); document.getElementById('mtQuit').click(); await e1.wait(100); out.cancelar={comprado:!!v.PRG.own[it.id], pagado:c0-v.PRG.coins, tarjeta:document.getElementById('mtCard').hidden?'cerrada':'abierta'};
  const cheap=v.SHOP.find(s=>s.p>0&&s.p<10&&!s.req&&!v.prgOwned(s)); out.barato=cheap?(v.prgBuy(cheap.id,()=>0)+' sin tarjeta: '+document.getElementById('mtCard').hidden):'no hay';
  v.mtP().lv=1; v.PRG.coins=300; it=pick(); document.querySelector('[data-buy="'+it.id+'"]').click(); out.nivel1={cuenta:v.MT.q.cur.key, texto:(document.querySelector('#mtCardB .mtfr')||{}).textContent}; document.getElementById('mtQuit').click(); v.mtP().lv=6; v.closeModal&&v.closeModal(); return out; })()
}}
# ---- disfraces de Halloween y garaje de karts también preguntan ----
{{
(async()=>{ const v=__vg, out={}; v.PRG.coins=60; v.hlSheet('disfraces'); await e1.wait(100); const b=[...document.querySelectorAll('[data-hlbuy]')].find(x=>{ const it=v.prgItem(x.dataset.hlbuy); return it&&!v.prgOwned(it)&&it.p>=10&&it.p<=60&&!it.req; });
  const it=v.prgItem(b.dataset.hlbuy); b.click(); out.halloween={modo:v.MT.q&&v.MT.q.mode, objeto:it.n}; e1.ans(true); await e1.wait(1100); out.halloween.comprado=!!v.PRG.own[it.id]; out.halloween.apunte=v.PRG.log.find(l=>l[1]<0)[1]+' · '+v.PRG.log.find(l=>l[1]<0)[2]; out.halloween.precio=it.p; document.getElementById('hlSheet').hidden=true;
  v.PRG.coins=150; v.kartGarage(); await e1.wait(100); document.getElementById('toastS').textContent=''; let kb=null; for(const x of [...document.querySelectorAll('#kartBody button[data-k="gs"],#kartBody button[data-k="gc"]')].filter(x=>/🔒/.test(x.textContent))){ x.click(); if(v.MT.q&&v.MT.q.mode==='shop'){ kb=x; break; } } out.garaje={boton:kb?kb.dataset.k+':'+kb.dataset.v:'ninguno', modo:v.MT.q&&v.MT.q.mode, avisoMalo:/Gran Premio/.test(document.getElementById('toastS').textContent)};
  if(kb){ e1.ans(true); await e1.wait(1500); out.garaje.pagado=150-v.PRG.coins; out.garaje.aviso=document.getElementById('toastS').textContent; out.garaje.apunte=v.PRG.log[0][2]; out.garaje.puesto=[...document.querySelectorAll('#kartBody button.on[data-k="'+kb.dataset.k+'"]')].map(x=>x.dataset.v).join(','); out.garaje.elegido=kb.dataset.v; }
  document.getElementById('kartSheet').hidden=true; return out; })()
}}
# ---- padres: interruptor «Cuentas en el juego»; textos: guía, glosario, cómo funciona, hoja Volar, mapa y leyenda ----
{{
(()=>{ const v=__vg; v.mtSheet('padres'); const B=document.getElementById('mtBody'); const b0=!!B.querySelector('[data-mto="ing0"]'); B.querySelector('[data-mto="ing0"]').click(); const off=v.MT.d.ing; document.getElementById('mtBody').querySelector('[data-mto="ing1"]').click();
  const on=v.MT.d.ing; v.mtSheet('como'); const como=document.getElementById('mtBody').textContent; v.mtSheet('jugar'); document.getElementById('mtClose').click();
  v.flSheet(); const fl=!!document.getElementById('meAirGo'); document.getElementById('flSheet').hidden=true;
  v.meStart('aire'); v.tick(2,1/30); const leg=v.extrasLegend?v.extrasLegend():'';
  return {interruptor:b0, apagado:off, encendido:on, como:['Cuentas en el juego','Aros de cuentas','Boyas de cuentas','Candado de números','Descuento','Cómo leer las puertas'].map(k=>k+':'+como.includes(k)), hojaVolar:fl, guia:v.mtGuideHTML().includes('aros de cuentas'), glosario:v.mtGlossHTML().includes('Candado de números'), leyenda:/Siguiente puerta de cuentas/.test(leg)}; })()
}}
js: (()=>{ const v=__vg; v.showMap&&v.showMap(); v.tick(2,1/30); return {mapa:!document.getElementById('mapOv').hidden, leyenda:(document.getElementById('mapLegend')||{textContent:''}).textContent.includes('Aros de cuentas')}; })()
